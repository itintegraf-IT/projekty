generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  blockId     Int
  userId      Int
  username    String
  action      String
  field       String?
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  createdAt   DateTime @default(now())
  orderNumber String?
  /// Korelace s BlockRevision. Nullable — historické řádky ho nemají.
  groupId     String?  @db.VarChar(32)

  @@index([blockId, createdAt])
  @@index([createdAt])
  @@index([groupId, blockId])
}

model BlockRevision {
  id          Int      @id @default(autoincrement())
  /// Jedna serverová transakce = jeden groupId napříč všemi dotčenými bloky.
  groupId     String   @db.VarChar(32)
  /// ZÁMĚRNĚ BEZ cizího klíče — revize musí přežít smazání bloku.
  /// Navíc: produkční Block.id je INT UNSIGNED, FK z INT by selhal na errno 150.
  blockId     Int
  /// Denormalizováno, aby řádek dával smysl i po smazání bloku.
  machine     String   @db.VarChar(191)
  orderNumber String?  @db.VarChar(191)
  /// Která mutační CESTA běžela — NE co se stalo s řádkem (to je `kind`).
  /// Vokabulář se NESMÍ míchat s `AuditLog.action`, tytéž tokeny tam znamenají
  /// něco jiného. Zdroj pravdy je `RevisionAction` v src/lib/revision.server.ts:
  /// CREATE|UPDATE|DELETE|BATCH|SPLIT|REFLOW|UNDO|REDO|PRINT_COMPLETE|PRINT_UNDO|
  /// EXPEDITION_PUBLISH|EXPEDITION_UNPUBLISH|EXPEDITION_REORDER
  action      String   @db.VarChar(32)
  /// Typ změny TOHOTO řádku. NIKDY se neodvozuje z přítomnosti before/after.
  kind        String   @db.VarChar(8)
  label       String   @db.VarChar(191)
  userId      Int
  username    String   @db.VarChar(191)
  /// Stav před změnou. U kind=CREATE chybí.
  /// kind=UPDATE: jen rozdílové sloupce, BEZ updatedAt (verze je v rowVersion).
  /// kind=DELETE: celý řádek VČETNĚ updatedAt — u smazaného bloku je `after`
  /// prázdné a rowVersion null, takže tohle je jediný záznam o jeho verzi.
  before      Json?
  /// Stav po změně. U kind=DELETE chybí.
  /// kind=UPDATE: jen rozdílové sloupce, BEZ updatedAt (verze je v rowVersion).
  /// kind=CREATE: celý řádek VČETNĚ updatedAt.
  after       Json?
  /// Block.updatedAt po zápisu — verze pro kontrolu souběhu v etapě B2.
  rowVersion  DateTime?
  /// Forenzní příznak: zachycení „před" nebylo úplné. NIKDY nesmí vyrobit undo operaci.
  partial     Boolean  @default(false)
  /// Řádek přišel přes hromadný zápis (`updateMany`/`deleteMany`), tedy jako ČLEN
  /// MNOŽINY vybrané podmínkou — ne jako adresně jmenovaný cíl. Odlišuje propagaci
  /// od přímé editace: u sdíleného pole na split skupině má editovaná hlava false
  /// a sourozenci true. Plní ho obal sám podle použité metody, volající nic nepředává.
  viaMany     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([groupId])
  @@index([blockId, createdAt])
  @@index([machine, createdAt])
  @@index([createdAt])
}

model LoginLog {
  id            Int      @id @default(autoincrement())
  userId        Int?     // null pro neznámé uživatelské jméno
  username      String
  success       Boolean
  failureReason String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([username, createdAt])
  @@index([createdAt])
}

model Block {
  id                                          Int          @id @default(autoincrement())
  orderNumber                                 String
  machine                                     String
  startTime                                   DateTime
  endTime                                     DateTime
  type                                        String       @default("ZAKAZKA")
  description                                 String?
  locked                                      Boolean      @default(false)
  deadlineExpedice                            DateTime?
  dataStatusId                                Int?
  dataStatusLabel                             String?
  dataRequiredDate                            DateTime?
  dataOk                                      Boolean      @default(false)
  materialStatusId                            Int?
  materialStatusLabel                         String?
  materialRequiredDate                        DateTime?
  materialOk                                  Boolean      @default(false)
  barvyStatusId                               Int?
  barvyStatusLabel                            String?
  lakStatusId                                 Int?
  lakStatusLabel                              String?
  specifikace                                 String?
  obalka                                      Boolean      @default(false)
  vnitrky                                     Boolean      @default(false)
  tiskoveArchy                                String?      @db.Text
  serie                                       String?      @db.Text
  recurrenceType                              String       @default("NONE")
  recurrenceParentId                          Int?
  createdAt                                   DateTime     @default(now())
  updatedAt                                   DateTime     @updatedAt
  printCompletedAt                            DateTime?
  printCompletedByUserId                      Int?
  printCompletedByUsername                    String?
  materialNote                                String?      @db.Text
  materialNoteByUsername                      String?
  blockVariant                                String       @default("STANDARD")
  splitGroupId                                Int?         @db.UnsignedInt
  materialInStock                             Boolean      @default(false)
  materialIssued                              Boolean      @default(false)
  pantoneRequired                             Boolean      @default(false)
  pantoneOk                                   Boolean      @default(false)
  pantoneRequiredDate                         DateTime?
  reservationId                               Int?
  jobPresetId                                 Int?
  jobPresetLabel                              String?
  doprava                                     String?
  expediceNote                                String?
  expeditionPublishedAt                       DateTime?
  expeditionSortOrder                         Int?
  printMinutes                                Int?
  scheduleBypassed                            Boolean      @default(false)
  Block_Block_recurrenceParentIdToBlock       Block?       @relation("Block_recurrenceParentIdToBlock", fields: [recurrenceParentId], references: [id])
  other_Block_Block_recurrenceParentIdToBlock Block[]      @relation("Block_recurrenceParentIdToBlock")
  Reservation                                 Reservation? @relation(fields: [reservationId], references: [id])
  splitGroup                                  SplitGroup?  @relation("BlockSplitGroup", fields: [splitGroupId], references: [id])
  notes                                       BlockNote[]

  @@index([deadlineExpedice, expeditionPublishedAt, expeditionSortOrder], map: "Block_expedition_idx")
  @@index([jobPresetId])
  @@index([recurrenceParentId])
  @@index([reservationId])
  @@index([splitGroupId])
  @@index([machine, startTime, endTime], map: "Block_machine_time_idx")
}

model SplitGroup {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  createdAt DateTime @default(now())
  blocks    Block[]  @relation("BlockSplitGroup")
}

model CodebookOption {
  id         Int     @id @default(autoincrement())
  category   String
  label      String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
  shortCode  String?
  isWarning  Boolean @default(false)
  badgeColor String?
}

model CompanyDay {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  label     String
  createdAt DateTime @default(now())
  machine   String?
}

model ExpeditionManualItem {
  id                  Int                       @id @default(autoincrement())
  date                DateTime?
  expeditionSortOrder Int?
  kind                ExpeditionManualItem_kind
  orderNumber         String?
  description         String?                   @db.Text
  expediceNote        String?                   @db.Text
  doprava             String?                   @db.Text
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @default(now())

  @@index([createdAt])
  @@index([date, expeditionSortOrder])
  @@index([kind, date])
}

model ExpeditionZavoz {
  id           Int      @id @default(autoincrement())
  date         DateTime
  orderNumber  String?
  description  String?
  expediceNote String?
  doprava      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([date])
}

model JobPreset {
  id                             Int      @id @default(autoincrement())
  name                           String
  isSystemPreset                 Boolean  @default(false)
  isActive                       Boolean  @default(true)
  sortOrder                      Int      @default(0)
  appliesToZakazka               Boolean  @default(true)
  appliesToRezervace             Boolean  @default(true)
  machineConstraint              String?
  blockVariant                   String?
  specifikace                    String?  @db.Text
  dataStatusId                   Int?
  dataRequiredDateOffsetDays     Int?
  materialStatusId               Int?
  materialRequiredDateOffsetDays Int?
  materialInStock                Boolean?
  pantoneRequired                Boolean?
  pantoneRequiredDateOffsetDays  Int?
  barvyStatusId                  Int?
  lakStatusId                    Int?
  deadlineExpediceOffsetDays     Int?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @default(now())

  @@index([isActive, sortOrder])
}

model MachineWorkHours {
  id        Int     @id @default(autoincrement())
  machine   String
  dayOfWeek Int
  startHour Int
  endHour   Int
  isActive  Boolean @default(true)

  @@unique([machine, dayOfWeek])
  @@index([machine])
}

model MachineWeekShifts {
  id          Int      @id @default(autoincrement())
  machine     String   @db.VarChar(20)
  weekStart   DateTime @db.Date
  dayOfWeek   Int
  isActive    Boolean  @default(true)
  morningOn   Boolean  @default(false)
  afternoonOn Boolean  @default(false)
  nightOn     Boolean  @default(false)
  // Override hodin per směna (null = default z SHIFT_HOURS). Minuty od půlnoci, snap 30.
  morningStartMin   Int?
  morningEndMin     Int?
  afternoonStartMin Int?
  afternoonEndMin   Int?
  nightStartMin     Int?
  nightEndMin       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([machine, weekStart, dayOfWeek])
  @@index([machine, weekStart])
  @@index([weekStart])
}

model Notification {
  id                Int       @id @default(autoincrement())
  blockId           Int?
  blockOrderNumber  String?
  targetRole        String?
  createdByUserId   Int
  createdByUsername String
  isRead            Boolean   @default(false)
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  message           String    @default("")
  reservationId     Int?
  targetUserId      Int?
  type              String    @default("BLOCK_NOTIFY")

  @@index([blockId, createdAt])
  @@index([reservationId, createdAt])
  @@index([targetRole, isRead, createdAt])
  @@index([targetUserId, isRead, createdAt])
}

model Reservation {
  id                      Int                     @id @default(autoincrement())
  code                    String                  @unique @default("")
  status                  String
  companyName             String
  erpOfferNumber          String
  requestedExpeditionDate DateTime?
  requestedDataDate       DateTime?
  requestText             String?                 @db.Text
  requestedByUserId       Int
  requestedByUsername     String
  plannerUserId           Int?
  plannerUsername         String?
  plannerDecisionReason   String?                 @db.Text
  planningPayload         Json?
  preparedAt              DateTime?
  scheduledBlockId        Int?
  scheduledMachine        String?
  scheduledStartTime      DateTime?
  scheduledEndTime        DateTime?
  scheduledAt             DateTime?
  confirmedAt                    DateTime?
  confirmedByUserId              Int?
  confirmedByUsername            String?
  counterProposedExpeditionDate  DateTime?
  counterProposedDataDate        DateTime?
  counterProposedReason          String?          @db.Text
  counterProposedAt              DateTime?
  counterProposedByUserId        Int?
  counterProposedByUsername      String?
  withdrawnAt                    DateTime?
  withdrawnReason                String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  blocks                  Block[]
  attachments             ReservationAttachment[]

  @@index([erpOfferNumber])
  @@index([requestedByUserId, status, createdAt])
  @@index([status, createdAt])
}

model ReservationAttachment {
  id                 Int         @id @default(autoincrement())
  reservationId      Int
  originalName       String
  storageKey         String      @unique
  mimeType           String
  sizeBytes          Int
  uploadedByUserId   Int
  uploadedByUsername String
  createdAt          DateTime    @default(now())
  reservation        Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model User {
  id              Int                @id @default(autoincrement())
  username        String             @unique
  passwordHash    String
  role            String             @default("VIEWER")
  createdAt       DateTime           @default(now())
  assignedMachine String?
  /// Verze session tokenů — bump zneplatní všechny vydané JWT uživatele
  /// (změna role/hesla, smazání účtu). Kontrola v getSession/sessionVersion.
  tokenVersion    Int                @default(0)
  preferences     UserPreference[]
}

model UserPreference {
  id     Int    @id @default(autoincrement())
  userId Int
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Printer {
  id          Int               @id @default(autoincrement())
  name        String
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assignments ShiftAssignment[]

  @@index([isActive, sortOrder])
}

model ShiftAssignment {
  id          Int       @id @default(autoincrement())
  machine     String
  date        DateTime
  shift       String
  printerId   Int
  note        String?
  sortOrder   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  printer     Printer   @relation(fields: [printerId], references: [id])

  @@unique([machine, date, shift, printerId])
  @@index([date, machine])
  @@index([publishedAt])
}

enum ExpeditionManualItem_kind {
  MANUAL_JOB
  INTERNAL_TRANSFER
}

model BlockNote {
  id                Int      @id @default(autoincrement())
  blockId           Int
  text              String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdByUserId   Int
  createdByUsername String

  block             Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, createdAt])
}
