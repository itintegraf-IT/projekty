# Integraf Výrobní plán — konfigurace prostředí
# Zkopíruj do .env a vyplň hodnoty

# ─── Databáze ────────────────────────────────────────────────────────────────
# MySQL připojení (databáze igvyroba)
# AMPPS výchozí: mysql://root:mysql@localhost:3306/igvyroba?charset=utf8mb4
DATABASE_URL="mysql://root:HESLO@localhost:3306/igvyroba?charset=utf8mb4"

# ─── Autentizace ─────────────────────────────────────────────────────────────
# JWT tajný klíč — POVINNÝ, bez něj se aplikace nespustí
# Vygeneruj: openssl rand -base64 32
JWT_SECRET="ZMEN_ME_NA_NAHODNY_RETEZEC"

# Příznak Secure u session cookie.
#   false = cookie bez Secure → funguje na čistém HTTP (nasazení ve firemní LAN).
#           POZOR: session cookie pak jde po síti v plaintextu.
#   true  = vždy Secure → jen pro HTTPS.
#   nenastaveno = odvodí se z hlavičky X-Forwarded-Proto, jinak z NODE_ENV.
# Produkce Integraf jede na HTTP → musí být false, jinak se nikdo nepřihlásí.
# Logika a testy: src/lib/cookieSecurity.ts · postup: docs/KIOSK_TERMINAL.md
COOKIE_SECURE=false
